{
  "name": "nexbash",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight rewrite of the original single-page site.",
  "homepage": "https://github.com/abdullah9558/nexbash-redesign#readme",
  "bugs": {
    "url": "https://github.com/abdullah9558/nexbash-redesign/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullah9558/nexbash-redesign.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "node server/index.js",
    "build": "next build",
    "start": "concurrently \"next start -p 3000\" \"node server/index.js\"",
    "start:web": "next start -p 3000",
    "start:api": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
